# Postgres connection string used by both the site analytics and the outreach relay
# (lib/db, lib/analytics, lib/relay) — they share one database.
# Easiest setup: Vercel dashboard -> your project -> Storage -> Create Database -> Neon (Postgres),
# then connect it to this project. That auto-populates DATABASE_URL (or POSTGRES_URL) for you —
# the code checks both names, so whichever Vercel sets will work.
# For local development, run `vercel env pull .env.local` after linking the project.
DATABASE_URL=

# Credentials for the /admin/analytics dashboard (HTTP Basic Auth).
ANALYTICS_DASHBOARD_USER=asad
ANALYTICS_DASHBOARD_PASSWORD=

# Shared secret your outreach backend uses to call the /r/* relay routes
# (POST /r/register, GET /r/events, POST /r/ack). Send it as: Authorization: Bearer <value>
RELAY_SHARED_SECRET=

# Optional: salt used when hashing visitor/recipient IPs before storage. Set your own random
# value — if omitted, a fixed fallback is used (fine for a personal project, but not ideal).
IP_HASH_SALT=
