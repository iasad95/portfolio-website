# Postgres connection string used by site analytics, the outreach relay, and dashboard login
# (lib/db, lib/analytics, lib/relay, lib/admin-auth) — they share one database.
# Easiest setup: Vercel dashboard -> your project -> Storage -> Create Database -> Neon (Postgres),
# then connect it to this project. Whatever name Vercel gives the variable (DATABASE_URL,
# POSTGRES_URL, or a prefixed one like <resource>_DATABASE_URL) is picked up automatically.
# For local development, run `vercel env pull .env.local` after linking the project.
DATABASE_URL=

# Recovery login for /admin — always works, even if you forget the password you set via
# /admin/settings. Look these up here (Vercel env vars), not anywhere else.
ANALYTICS_DASHBOARD_USER=asad
ANALYTICS_DASHBOARD_PASSWORD=

# Recommended: secret used to sign the /admin session cookie. If omitted, it falls back to
# ANALYTICS_DASHBOARD_PASSWORD (works, but reuses one secret for two jobs) — set your own
# random value here instead, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Shared secret your outreach backend uses to call the /r/* relay routes
# (POST /r/register, GET /r/events, POST /r/ack). Send it as: Authorization: Bearer <value>
RELAY_SHARED_SECRET=

# Optional: salt used when hashing visitor/recipient IPs before storage. Set your own random
# value — if omitted, a fixed fallback is used (fine for a personal project, but not ideal).
IP_HASH_SALT=
